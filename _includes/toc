{% comment %}
  Layouts run after Markdown conversion. Use the rendered headings and their
  existing IDs so that custom anchors and non-Latin headings remain unchanged.
{% endcomment %}
{% assign toc_sections = include.html | default: content | split: '<h' %}
{% capture toc_entries %}
  {% for section in toc_sections offset:1 %}
    {% assign heading_level = section | slice: 0, 1 %}
    {% assign heading_open = section | split: '>' | first %}
    {% if heading_level == '2' or heading_level == '3' %}
      {% assign heading_id = '' %}
      {% if heading_open contains 'id="' %}
        {% assign heading_id = heading_open | split: 'id="' | last | split: '"' | first %}
      {% elsif heading_open contains "id='" %}
        {% assign heading_id = heading_open | split: "id='" | last | split: "'" | first %}
      {% endif %}
      {% assign heading_text = section | split: '</h' | first | remove_first: heading_open | remove_first: '>' | strip_html | strip %}
      {% if heading_id != '' and heading_text != '' %}
        <li class="toc__entry--h{{ heading_level }}"><a href="#{{ heading_id | escape }}">{{ heading_text | escape_once }}</a></li>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign toc_entries = toc_entries | strip %}
{% if toc_entries != '' %}
  {% assign toc_title = include.title | default: site.data.ui-text[site.locale].toc_label | default: 'On This Page' %}
  <nav class="toc page__toc" aria-label="{{ toc_title | escape }}">
    <h2 class="nav__title">{{ toc_title | escape }}</h2>
    <ol class="toc__menu">{{ toc_entries }}</ol>
  </nav>
{% endif %}
